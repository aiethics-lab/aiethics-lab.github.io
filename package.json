{
  "name": "ai-data-ethics-toolkit",
  "version": "3.1.0",
  "description": "Browser-based labs for an undergraduate AI and data ethics course.",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build:css": "tailwindcss -i ./build/tailwind.src.css -o ./shared/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./build/tailwind.src.css -o ./shared/tailwind.css --watch",
    "serve": "python3 -m http.server 8000",
    "data": "python3 data/generate_samples.py"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17",
    "@tailwindcss/forms": "0.5.10",
    "@tailwindcss/container-queries": "0.1.1"
  }
}
